---
import { getAppDb } from '../db'
import BaseLayout from '../layouts/BaseLayout.astro'
import { imageUrl } from '../lib/media/image-url'
import {
  getBySlug,
  getBySlugForOwner,
  resolveArticlesForPage,
} from '../lib/pages/repo'

// Public page route (docs/superpowers/specs/2026-09-18-pages-design.md):
// reachable at its chosen slug, no auth required for a PUBLIC page. A
// signed-in owner can additionally preview a still-private page here (not
// yet true of articles/photo tags — deliberately scoped to pages only, see
// user feedback that prompted this) via getBySlugForOwner, which skips the
// visibility filter; everyone else still 404s on a private slug.
const db = getAppDb()
const page = Astro.locals.user
  ? await getBySlugForOwner(db, Astro.params.slug ?? '')
  : await getBySlug(db, Astro.params.slug ?? '')
if (!page) {
  return new Response('Not found', { status: 404 })
}
const tiles = await resolveArticlesForPage(db, page)
---

<BaseLayout title={`${page.title} — peterjur.co`}>
  <main class="page-view">
    {page.visibility === 'private' && (
      <p class="preview-banner">Private — only visible to you, signed in.</p>
    )}
    <h1>{page.title}</h1>
    {tiles.length === 0 && <p class="empty">Nothing here yet.</p>}
    <ul class="page-tile-grid">
      {
        tiles.map((tile) => (
          <li>
            <a
              href={`/a/${tile.publicId}`}
              class={tile.imageKey ? 'has-image' : 'text-only'}
            >
              {tile.imageKey ? (
                <>
                  <img
                    src={imageUrl(tile.imageKey, { width: 640 })}
                    alt={tile.title}
                    loading="lazy"
                  />
                  <span class="scrim" />
                  <h4>{tile.title}</h4>
                </>
              ) : (
                <h4>{tile.title}</h4>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .page-view {
    --ink: #17140f;
    --cream: #f0e7d3;
    min-height: 100vh;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
    background: var(--ink);
    color: var(--cream);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  :global(body) {
    margin: 0;
    background: #17140f;
  }

  .page-view h1 {
    margin: 0 0 2rem;
    font-family: "Unbounded Variable", "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: 0.02em;
  }

  .empty {
    color: color-mix(in srgb, var(--cream) 65%, transparent);
  }

  .preview-banner {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cream);
    border-radius: 4px;
  }

  .page-tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .page-tile-grid a {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
  }

  /* Both tile variants sit on a dark background, so the ring needs to be
     --cream for contrast — same "outline color contrasts with this tile's
     own background" convention as public-home.css's tile focus states. */
  .page-tile-grid a:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 3px;
  }

  .page-tile-grid a.has-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.74) contrast(0.94) brightness(0.98);
    transition: filter 1s ease;
  }

  .page-tile-grid a.has-image:hover img,
  .page-tile-grid a.has-image:focus-visible img {
    filter: saturate(1.08) contrast(1.04) brightness(1.03);
  }

  .page-tile-grid .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(23, 20, 15, 0.85), transparent 55%);
  }

  .page-tile-grid a.has-image h4 {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.6rem;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .page-tile-grid a.text-only {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.8rem;
    background: color-mix(in srgb, var(--cream) 8%, transparent);
  }

  .page-tile-grid a.text-only h4 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-tile-grid a.has-image img {
      transition-duration: 0.001ms;
    }
  }
</style>
