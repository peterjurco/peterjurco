---
import { getAppDb } from '../db'
import BaseLayout from '../layouts/BaseLayout.astro'
import { formatFullDate } from '../lib/format-date'
import { imageUrl } from '../lib/media/image-url'
import {
  getBySlug,
  getBySlugForOwner,
  resolveArticlesForPage,
} from '../lib/pages/repo'

// Public page route (docs/superpowers/specs/2026-09-18-pages-design.md):
// reachable at its chosen slug, no auth required for a PUBLIC page. A
// signed-in owner can additionally preview a still-private page here (not
// yet true of articles/photo tags — deliberately scoped to pages only, see
// user feedback that prompted this) via getBySlugForOwner, which skips the
// visibility filter; everyone else still 404s on a private slug. The same
// owner-preview also includes draft (private) articles in the tile
// resolution, so previewing a page shows what it'll look like once its
// articles are published too — not just once the page itself is public.
const isOwnerPreview = Astro.locals.user !== null
const db = getAppDb()
const page = isOwnerPreview
  ? await getBySlugForOwner(db, Astro.params.slug ?? '')
  : await getBySlug(db, Astro.params.slug ?? '')
if (!page) {
  return new Response('Not found', { status: 404 })
}
const tiles = await resolveArticlesForPage(db, page, {
  includePrivate: isOwnerPreview,
})
---

<BaseLayout title={`${page.title} — peterjur.co`}>
  <main class="page-view">
    <h1>{page.title}</h1>
    {tiles.length === 0 && <p class="empty">Nothing here yet.</p>}
    <ul class="page-tile-grid">
      {
        tiles.map((tile) => (
          <li>
            <a href={`/a/${tile.publicId}`}>
              <span class="cover">
                {tile.imageKey ? (
                  <img
                    src={imageUrl(tile.imageKey, { width: 640 })}
                    alt={tile.title}
                    loading="lazy"
                  />
                ) : (
                  <span class="cover-placeholder" aria-hidden="true" />
                )}
              </span>
              <span class="caption">{tile.title}</span>
              {page.showTags && tile.tags.length > 0 && (
                <span class="tags">
                  {tile.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
              )}
              {(page.showCreatedDate || page.showUpdatedDate) && (
                <span class="dates">
                  {page.showCreatedDate && (
                    <time datetime={tile.createdAt.toISOString()}>
                      {formatFullDate(tile.createdAt)}
                    </time>
                  )}
                  {page.showUpdatedDate && (
                    <time datetime={tile.updatedAt.toISOString()}>
                      Updated {formatFullDate(tile.updatedAt)}
                    </time>
                  )}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .page-view {
    --ink: #17140f;
    --cream: #f0e7d3;
    min-height: 100vh;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
    background: var(--ink);
    color: var(--cream);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  :global(body) {
    margin: 0;
    background: #17140f;
  }

  .page-view h1 {
    margin: 0 0 2rem;
    font-family: "Unbounded Variable", "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: 0.02em;
  }

  .empty {
    color: color-mix(in srgb, var(--cream) 65%, transparent);
  }

  /* Loosely mirrors the photo hub's album grid (src/pages/t/[publicId].astro)
     — caption below, not overlaid, same muted-to-vivid "develop" hover
     recipe — but narrower/taller (a phone-camera-photo ratio, not the
     photo hub's own), a bigger caption, and a snappier hover per feedback. */
  .page-tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.75rem 1rem;
    padding: 0;
    list-style: none;
  }

  .page-tile-grid a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .page-tile-grid .cover {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 3px;
    background: color-mix(in srgb, var(--cream) 8%, transparent);
  }

  .page-tile-grid .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* "Develop": muted at rest, blooms into full color on hover/focus —
       same recipe as public-home.css's photo tiles, tuned faster. */
    filter: saturate(0.74) contrast(0.94) brightness(0.98);
    transition: filter 0.3s ease;
  }

  .page-tile-grid a:hover .cover img,
  .page-tile-grid a:focus-visible .cover img {
    filter: saturate(1.08) contrast(1.04) brightness(1.03);
  }

  .page-tile-grid .cover-placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page-tile-grid .caption {
    display: block;
    margin-top: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--cream) 80%, transparent);
  }

  .page-tile-grid a:hover .caption,
  .page-tile-grid a:focus-visible .caption {
    color: var(--cream);
  }

  .page-tile-grid .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }

  .page-tile-grid .tag {
    padding: 0.1rem 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    background: color-mix(in srgb, var(--cream) 10%, transparent);
    border-radius: 3px;
  }

  .page-tile-grid .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin-top: 0.3rem;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--cream) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-tile-grid .cover img {
      transition-duration: 0.001ms;
    }
  }
</style>
