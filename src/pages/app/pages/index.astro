---
import AppNav from '../../../components/AppNav.astro'
import { getAppDb } from '../../../db'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { listForOwner } from '../../../lib/pages/repo'

// Defense in depth: the middleware already gates /app/*.
if (!Astro.locals.user) {
  return Astro.redirect('/api/auth/login', 302)
}

const db = getAppDb()
const pages = await listForOwner(db)
---

<BaseLayout title="Pages — peterjur.co">
  <AppNav />
  <main class="admin-shell pages-list">
    <header class="header-split">
      <h1>Pages</h1>
      <a href="/app/pages/new" class="admin-btn admin-btn--primary">New page</a>
    </header>
    {pages.length === 0 && <p>No pages yet.</p>}
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={`/app/pages/${page.id}`}>{page.title || 'Untitled'}</a>
            <span class="page-meta">
              <span class="admin-mono">/{page.slug}</span>
              {page.visibility === 'public' && (
                <span class="badge badge-public">Public</span>
              )}
              <span class="badge">{page.mode === 'manual' ? 'Manual' : 'Auto'}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p><a href="/app">← Back</a></p>
  </main>
</BaseLayout>

<style>
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--admin-border-light);
  }
  li a {
    font-weight: 600;
    color: var(--admin-accent);
  }
  .page-meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-left: auto;
  }
</style>
