---
import AppNav from '../../../components/AppNav.astro'
import { getAppDb } from '../../../db'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { listCategories, listForOwner } from '../../../lib/articles/repo'
import { formatFullDate, formatRelativeDate } from '../../../lib/format-date'

// Defense in depth: the middleware already gates /app/*.
if (!Astro.locals.user) {
  return Astro.redirect('/api/auth/login', 302)
}

const db = getAppDb()

const categoryParam = Astro.url.searchParams.get('category') ?? ''
const searchParam = Astro.url.searchParams.get('q') ?? ''
// Blank/non-numeric ("All categories") means no category filter.
const categoryId = categoryParam ? Number(categoryParam) : undefined

const [categories, articles] = await Promise.all([
  listCategories(db),
  listForOwner(db, {
    categoryId: Number.isNaN(categoryId) ? undefined : categoryId,
    search: searchParam || undefined,
  }),
])
---

<BaseLayout title="Articles — peterjur.co">
  <AppNav />
  <main class="admin-shell articles-list">
    <header class="header-split">
      <h1>Articles</h1>
      <form method="post" action="/app/articles/new">
        <button type="submit" class="admin-btn admin-btn--primary">
          New article
        </button>
      </form>
    </header>
    <form method="get" class="article-filters">
      <label>
        Category
        <select name="category">
          <option value="">All categories</option>
          {
            categories.map((category) => (
              <option
                value={category.id}
                selected={categoryParam === String(category.id)}
              >
                {category.name}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        Search
        <input
          type="search"
          name="q"
          placeholder="Title or article text…"
          value={searchParam}
        />
      </label>
      <button type="submit" class="admin-btn">Filter</button>
      {(categoryParam || searchParam) && (
        <a href="/app/articles">Clear</a>
      )}
    </form>
    {articles.length === 0 && (
      <p>{categoryParam || searchParam ? 'No articles match.' : 'No articles yet.'}</p>
    )}
    <ul>
      {
        articles.map((article) => (
          <li>
            <a href={`/app/articles/${article.id}`}>
              {article.title || 'Untitled'}
            </a>
            {article.categoryName && (
              <span class="category">{article.categoryName}</span>
            )}
            <span class={`badge badge-${article.visibility}`}>
              {article.visibility}
            </span>
            {article.isFeatured && <span class="badge">featured</span>}
            <span class="article-dates">
              <time datetime={article.createdAt.toISOString()}>
                Created {formatFullDate(article.createdAt)}
              </time>
              <time datetime={article.updatedAt.toISOString()}>
                Modified {formatRelativeDate(article.updatedAt)}
              </time>
            </span>
          </li>
        ))
      }
    </ul>
    <p><a href="/app">← Back</a></p>
  </main>
</BaseLayout>

<style>
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--admin-border-light, #eee);
  }
  li a {
    font-weight: 600;
    color: var(--admin-accent, #333);
  }
  .category {
    color: var(--admin-muted, #666);
    font-size: 0.85rem;
  }
  .article-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .article-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--admin-muted, #666);
  }
  .article-dates {
    margin-left: auto;
    display: flex;
    gap: 0.75rem;
  }
  time {
    color: var(--admin-faint, #999);
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
