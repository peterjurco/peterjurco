---
import AppNav from '../../../components/AppNav.astro'
import { ArticleEditor } from '../../../components/ArticleEditor'
import { ArticleMetaPanel } from '../../../components/ArticleMetaPanel'
import { getAppDb } from '../../../db'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { parseId } from '../../../lib/api'
import {
  getById,
  listCategories,
  listTags,
  listTopTagsByCategory,
} from '../../../lib/articles/repo'

// Defense in depth: the middleware already gates /app/*.
if (!Astro.locals.user) {
  return Astro.redirect('/api/auth/login', 302)
}

const id = parseId(Astro.params.id)
if (id === null) {
  return new Response('Not found', { status: 404 })
}

const db = getAppDb()
const [article, categories, allTags, topTagsByCategory] = await Promise.all([
  getById(db, id),
  listCategories(db),
  listTags(db),
  listTopTagsByCategory(db, 5),
])
if (!article) {
  return new Response('Not found', { status: 404 })
}

// The "popular in this category" quick-add chips only make sense while
// actively drafting — once an article is old, its own established tags
// matter more than the whole category's current trends.
const now = new Date()
const createdToday =
  article.createdAt.getUTCFullYear() === now.getUTCFullYear() &&
  article.createdAt.getUTCMonth() === now.getUTCMonth() &&
  article.createdAt.getUTCDate() === now.getUTCDate()
---

<BaseLayout title={`${article.title || 'Untitled'} — peterjur.co`}>
  <AppNav />
  <main class="admin-shell article-editor-page">
    <ArticleMetaPanel
      client:load
      articleId={article.id}
      publicId={article.publicId}
      initialTitle={article.title}
      initialVisibility={article.visibility}
      initialCategoryId={article.categoryId}
      initialTags={article.tags.map((tag) => tag.name)}
      initialIsFeatured={article.isFeatured}
      categories={categories.map(({ id, name }) => ({ id, name }))}
      allTagNames={allTags.map((tag) => tag.name)}
      topTagsByCategory={topTagsByCategory}
      createdToday={createdToday}
    />
    <ArticleEditor
      client:load
      articleId={article.id}
      editable={true}
      initialContent={article.content as Record<string, unknown>}
    />
  </main>
</BaseLayout>
