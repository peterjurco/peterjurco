---
import '@fontsource-variable/archivo/index.css'
import '@fontsource-variable/source-serif-4/index.css'
import '@fontsource-variable/unbounded/index.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import { getAppDb } from '../../db'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { absoluteUrl } from '../../lib/absolute-url'
import { deriveExcerpt } from '../../lib/articles/excerpt'
import { renderDoc } from '../../lib/articles/render-doc'
import { getByPublicId, getByPublicIdForOwner } from '../../lib/articles/repo'
import { imageUrl } from '../../lib/media/image-url'
import '../../styles/article-body.css'

// Public read view (TECH_DECISIONS §9): pure SSR — no editor JS is shipped.
// getByPublicId returns only public articles, so private ids 404 here; a
// signed-in owner instead gets getByPublicIdForOwner (no visibility
// filter), matching the same preview allowance already built for pages.
const isOwnerPreview = Astro.locals.user !== null
const db = getAppDb()
const article = isOwnerPreview
  ? await getByPublicIdForOwner(db, Astro.params.publicId ?? '')
  : await getByPublicId(db, Astro.params.publicId ?? '')
if (!article) {
  return new Response('Not found', { status: 404 })
}

const title = article.title || 'Untitled'
const description = deriveExcerpt(article.content, 200)
const html = renderDoc(article.content)
const canonicalUrl = new URL(Astro.url.pathname, Astro.url)
// og:image must be absolute — imageUrl is zone-relative when transforms are
// on (see its docblock), so absolutize against the request URL. Same
// convention as src/pages/t/[publicId].astro.
const ogImage = article.featuredPhotoKey
  ? absoluteUrl(imageUrl(article.featuredPhotoKey, { width: 1200 }), Astro.url)
  : null
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </Fragment>
  <main class="public-article">
    {isOwnerPreview && (
      <a class="public-article-edit" href={`/app/articles/${article.id}`}>
        Edit
      </a>
    )}
    <article>
      {article.featuredPhotoKey && (
        <img
          class="public-article-cover"
          src={imageUrl(article.featuredPhotoKey, { width: 1200 })}
          alt=""
          loading="eager"
        />
      )}
      <h1>{title}</h1>
      <div class="article-body" set:html={html} />
    </article>
  </main>
</BaseLayout>

<style is:global>
  .public-article {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: Georgia, serif;
    line-height: 1.7;
  }
  .public-article h1 {
    line-height: 1.2;
  }
  .public-article-edit {
    position: absolute;
    top: 1.5rem;
    right: 1rem;
    padding: 0.4rem 0.85rem;
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: #17140f;
    background: #f0e7d3;
    border-radius: 6px;
    text-decoration: none;
  }
  .public-article-cover {
    display: block;
    width: 100%;
    max-height: 26rem;
    margin: 0 0 1.5rem;
    object-fit: cover;
    border-radius: 6px;
  }
</style>
