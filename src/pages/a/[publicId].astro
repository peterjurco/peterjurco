---
import '@fontsource-variable/archivo/index.css'
import '@fontsource-variable/source-serif-4/index.css'
import '@fontsource-variable/unbounded/index.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import { getAppDb } from '../../db'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { absoluteUrl } from '../../lib/absolute-url'
import { deriveExcerpt } from '../../lib/articles/excerpt'
import { renderDoc } from '../../lib/articles/render-doc'
import { getByPublicId } from '../../lib/articles/repo'
import { imageUrl } from '../../lib/media/image-url'
import '../../styles/article-body.css'

// Public read view (TECH_DECISIONS §9): pure SSR — no editor JS is shipped.
// getByPublicId returns only public articles, so private ids 404 here.
const db = getAppDb()
const article = await getByPublicId(db, Astro.params.publicId ?? '')
if (!article) {
  return new Response('Not found', { status: 404 })
}

const title = article.title || 'Untitled'
const description = deriveExcerpt(article.content, 200)
const html = renderDoc(article.content)
const canonicalUrl = new URL(Astro.url.pathname, Astro.url)
// og:image must be absolute — imageUrl is zone-relative when transforms are
// on (see its docblock), so absolutize against the request URL. Same
// convention as src/pages/t/[publicId].astro.
const ogImage = article.featuredPhotoKey
  ? absoluteUrl(imageUrl(article.featuredPhotoKey, { width: 1200 }), Astro.url)
  : null
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </Fragment>
  <main class="public-article">
    <article>
      <h1>{title}</h1>
      <div class="article-body" set:html={html} />
    </article>
  </main>
</BaseLayout>

<style is:global>
  .public-article {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: Georgia, serif;
    line-height: 1.7;
  }
  .public-article h1 {
    line-height: 1.2;
  }
</style>
