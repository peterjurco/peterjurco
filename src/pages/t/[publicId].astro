---
import '@fontsource-variable/unbounded/index.css'
import { getAppDb } from '../../db'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { absoluteUrl } from '../../lib/absolute-url'
import { imageUrl } from '../../lib/media/image-url'
import { DEFAULT_COVER_ASPECT_RATIO } from '../../lib/photos/cover-aspect-ratio'
import { getPublicTagByPublicId } from '../../lib/photos/repo'

// Public tag page (REQUIREMENTS "Public sharing via tags"): reachable only
// through the tag's opaque public id (TECH_DECISIONS §9), no auth. The
// accessor is SQL-filtered to visibility='public', so private tags 404 here
// by construction. Pure SSR — no islands shipped.
const db = getAppDb()
const tag = await getPublicTagByPublicId(db, Astro.params.publicId ?? '')
if (!tag) {
  return new Response('Not found', { status: 404 })
}

const title = `${tag.name} — photo albums`
const description = `Photo albums tagged “${tag.name}”.`
const canonicalUrl = new URL(Astro.url.pathname, Astro.url)
const firstCover = tag.albums.find((album) => album.coverImageKey)
// og:image must be absolute — imageUrl is zone-relative when transforms are
// on (see its docblock), so absolutize against the request URL.
const ogImage = firstCover?.coverImageKey
  ? absoluteUrl(imageUrl(firstCover.coverImageKey, { width: 1200 }), Astro.url)
  : null
const coverAspectRatio = tag.coverAspectRatio ?? DEFAULT_COVER_ASPECT_RATIO
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </Fragment>
  <main class="public-tag">
    <h1>{tag.name}</h1>
    <div class="public-tag-rule"></div>
    {tag.albums.length === 0 && <p class="empty">No albums here yet.</p>}
    <ul class="album-grid" style={`--cover-ratio: ${coverAspectRatio}`}>
      {
        tag.albums.map((album) => (
          <li>
            <a
              href={album.googlePhotosUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="cover">
                {album.coverImageKey ? (
                  <img
                    src={imageUrl(album.coverImageKey, { width: 640 })}
                    alt={album.name}
                    loading="lazy"
                  />
                ) : (
                  <span class="cover-placeholder" aria-hidden="true" />
                )}
              </span>
              <span class="caption">{album.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .public-tag {
    --ink: #17140f;
    --accent: #b23a26;
    --cream: #f0e7d3;
    min-height: 100vh;
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
    background: var(--ink);
    color: var(--cream);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  :global(body) {
    margin: 0;
    background: #17140f;
  }

  .public-tag h1 {
    margin: 0;
    font-family: "Unbounded Variable", "Unbounded", sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .public-tag-rule {
    width: 2.5rem;
    height: 4px;
    margin: 0.75rem 0 2.5rem;
    background: var(--accent);
  }

  .empty {
    color: color-mix(in srgb, var(--cream) 65%, transparent);
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1.75rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .album-grid a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cover {
    display: block;
    aspect-ratio: var(--cover-ratio, 4 / 5);
    overflow: hidden;
    border-radius: 3px;
    background: color-mix(in srgb, var(--cream) 8%, transparent);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* "Develop": muted at rest, blooms into full color on hover/focus —
       the same effect as the homepage's photo tiles (public-home.css). */
    filter: saturate(0.74) contrast(0.94) brightness(0.98);
    transition: filter 1s ease;
  }

  .album-grid a:hover .cover img,
  .album-grid a:focus-visible .cover img {
    filter: saturate(1.08) contrast(1.04) brightness(1.03);
  }

  .cover-placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .caption {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--cream) 80%, transparent);
  }

  .album-grid a:hover .caption,
  .album-grid a:focus-visible .caption {
    color: var(--cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover img {
      transition-duration: 0.001ms;
    }
  }
</style>
